@model ExcellentTaste.Core.Models.Reservering

@{
    ViewData["Title"] = "Restaurant Excellent Taste";
}

<form asp-action="Delete" asp-route-id="@Model.ReserveringId" method="post" class="delete-dialog">
    <p>Weet u zeker dat deze reservering verwijderd moet worden?</p>
    <table>
        <tbody>
            <tr>
                <th>Datum</th>
                <td>@Model.Datum.ToString("dd-MM-yyyy")</td>
            </tr>
            <tr>
                <th>Tijd</th>
                <td>@Model.Tijd.ToString("HH:mm")</td>
            </tr>
            <tr>
                <th>Tafel</th>
                <td>@Model.Tafel</td>
            </tr>
            <tr>
                <th>Klant</th>
                <td>@Model.KlantNaam</td>
            </tr>
        </tbody>
    </table>
    <div class="centered">
        <button type="submit" class="btn btn-primary">Verwijderen</button>
        <a asp-action="Index" class="btn btn-default">Annuleren</a>
    </div>
</form>
