@model ExcellentTaste.Web.ViewModels.OverzichtenViewModel

@{
    ViewData["Title"] = "Restaurant Excellent Taste";
}

@if (!string.IsNullOrWhiteSpace(Model.ApiFout))
{
    <script>
        alert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApiFout)));
    </script>
}

<div class="overzicht-page">
    <table>
        <thead>
            <tr>
                <th colspan="3">@Model.Titel</th>
            </tr>
            <tr>
                <th>Tafel</th>
                <th>Aantal</th>
                <th>@Model.ItemKolom</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var regel in Model.Regels)
            {
                <tr>
                    <td>@regel.Tafel</td>
                    <td>@regel.Aantal</td>
                    <td>@regel.MenuItemNaam</td>
                </tr>
            }
        </tbody>
    </table>
</div>
